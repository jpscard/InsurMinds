# Copie este arquivo para .env e preencha. O .env NÃO deve ir para o Git.

# Provedor de LLM: anthropic | openai | gemini | offline
# "offline" roda sem IA (regras heurísticas), útil para testar a interface.
LLM_PROVIDER=anthropic

# Modelo (opcional). Se vazio, usa o padrão do provedor:
#   anthropic: claude-sonnet-5 | openai: gpt-4.1-mini | gemini: gemini-2.5-flash
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Parâmetros de geração
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=3

# OCR (Tesseract)
OCR_LANG=por+eng
OCR_DPI=300
OCR_PSM=6
# No Windows, se o tesseract não estiver no PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Documentos maiores que isto (em caracteres) são extraídos em blocos
CHUNK_CHARS=60000
